#!/usr/bin/env bash
# Gate: syncfusion-license
#
# Asserts two facts a tool can check and an LLM cannot be trusted to:
#   1. RegisterLicense / registerLicense is called on the startup path.
#   2. The key it passes comes from configuration or the environment - not a
#      string literal, and never inside a client-shipped (WASM/browser) project.
#
# Exit 0 = pass. Exit 1 = fail with an actionable message.
# Generated by harness-creator. Adjust STARTUP_GLOBS for your layout.

set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

fail() { echo "FAIL: $*" >&2; FAILED=1; }
note() { echo "      $*" >&2; }
FAILED=0

# Files that may legitimately register the license.
STARTUP_GLOBS=(
  "**/Program.cs" "**/Startup.cs" "**/MauiProgram.cs" "**/App.xaml.cs"
  "**/main.ts" "**/main.tsx" "**/main.js" "**/index.tsx" "**/app.config.ts"
  "**/_Imports.razor" "**/App.razor"
)

SKIP_DIRS='-path ./node_modules -o -path ./.git -o -path */obj -o -path */bin -o -path ./dist -o -path ./.agent'

# ---------------------------------------------------------------------------
# 1. Is a Syncfusion dependency actually present? If not, the gate is vacuous.
# ---------------------------------------------------------------------------
HAS_SF=0
if find . \( $SKIP_DIRS \) -prune -o -name '*.csproj' -print 2>/dev/null \
     | xargs grep -l 'Include="Syncfusion\.' 2>/dev/null | grep -q .; then
  HAS_SF=1
fi
if find . \( $SKIP_DIRS \) -prune -o -name 'package.json' -print 2>/dev/null \
     | xargs grep -l '"@syncfusion/' 2>/dev/null | grep -q .; then
  HAS_SF=1
fi
if [ "$HAS_SF" -eq 0 ]; then
  echo "SKIP: no Syncfusion packages referenced; license gate not applicable."
  exit 0
fi

# ---------------------------------------------------------------------------
# 2. Find registration call sites.
# ---------------------------------------------------------------------------
REG_FILES=$(find . \( $SKIP_DIRS \) -prune -o -type f \
              \( -name '*.cs' -o -name '*.ts' -o -name '*.tsx' -o -name '*.js' \
                 -o -name '*.jsx' -o -name '*.razor' -o -name '*.vue' \) -print 2>/dev/null \
            | xargs grep -lE 'SyncfusionLicenseProvider\.RegisterLicense|registerLicense\(' 2>/dev/null)

if [ -z "$REG_FILES" ]; then
  fail "no Syncfusion license registration found anywhere in the project."
  note "Syncfusion controls will render a trial banner in production."
  note "Add on the startup path, reading the key from configuration:"
  note "  .NET:      SyncfusionLicenseProvider.RegisterLicense(builder.Configuration[\"Syncfusion:LicenseKey\"]);"
  note "  JS/TS:     registerLicense(import.meta.env.VITE_SYNCFUSION_LICENSE);"
  note "  Docs:      https://help.syncfusion.com/common/essential-studio/licensing/licensing-faq"
  exit 1
fi

echo "Registration found in:"
echo "$REG_FILES" | sed 's/^/  /'

# ---------------------------------------------------------------------------
# 3. Is the key a literal? This is the failure that leaks a paid license key.
#    A real key is a long base64-ish blob; match on length, not on content.
# ---------------------------------------------------------------------------
for f in $REG_FILES; do
  if grep -qE '(RegisterLicense|registerLicense)\(\s*"[A-Za-z0-9+/=@;#_-]{40,}"' "$f"; then
    fail "$f passes the license key as a string literal."
    note "The key is a paid credential. Committing it exposes it to anyone with repo"
    note "access, and in a client-side project it ships to every visitor."
    note "Read it from configuration or the environment instead."
  fi
done

# ---------------------------------------------------------------------------
# 4. Is a key literal present in a project that ships to the browser?
# ---------------------------------------------------------------------------
WASM_PROJECTS=$(find . \( $SKIP_DIRS \) -prune -o -name '*.csproj' -print 2>/dev/null \
                | xargs grep -lE 'Microsoft\.NET\.Sdk\.BlazorWebAssembly|BlazorWebAssembly' 2>/dev/null)
for proj in $WASM_PROJECTS; do
  dir=$(dirname "$proj")
  if grep -rqE '(RegisterLicense|registerLicense)\(\s*"[A-Za-z0-9+/=@;#_-]{40,}"' "$dir" 2>/dev/null; then
    fail "$proj is a WebAssembly project containing a literal license key."
    note "Everything in a WASM project is downloaded by the browser. Register the"
    note "license from a server-side host, or serve the key from a protected endpoint."
  fi
  # Guard against an empty file list: bare `xargs grep` would read stdin and
  # report a spurious match.
  settings=$(find "$dir" -name 'appsettings*.json' 2>/dev/null)
  if [ -n "$settings" ] && echo "$settings" | tr '\n' '\0' \
       | xargs -0 grep -liE 'licensekey' 2>/dev/null | grep -q .; then
    fail "$proj ships an appsettings file containing a license key."
    note "WASM appsettings files are served to the browser like any other asset."
  fi
done

# ---------------------------------------------------------------------------
# 5. Ordering: registration must precede component use in the same file.
# ---------------------------------------------------------------------------
for f in $REG_FILES; do
  case "$f" in
    *Program.cs|*MauiProgram.cs|*Startup.cs)
      reg=$(grep -nE 'RegisterLicense' "$f" | head -1 | cut -d: -f1)
      use=$(grep -nE 'AddSyncfusionBlazor|ConfigureSyncfusionCore' "$f" | head -1 | cut -d: -f1)
      if [ -n "$reg" ] && [ -n "$use" ] && [ "$reg" -gt "$use" ]; then
        fail "$f registers the license (line $reg) AFTER Syncfusion setup (line $use)."
        note "Registration must come first or the first render is unlicensed."
      fi
      ;;
  esac
done

if [ "$FAILED" -ne 0 ]; then
  exit 1
fi
echo "PASS: license registered, key not hard-coded, ordering correct."
