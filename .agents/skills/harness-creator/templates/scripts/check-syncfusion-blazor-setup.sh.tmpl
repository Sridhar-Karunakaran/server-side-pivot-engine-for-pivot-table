#!/usr/bin/env bash
# Gate: syncfusion-blazor-setup
#
# Three Syncfusion Blazor requirements that fail SILENTLY - no exception, no
# build error, no failing unit test:
#   1. AddSyncfusionBlazor() missing  -> components render EMPTY
#   2. theme stylesheet not linked    -> components render unstyled
#   3. no render mode (.NET 8+ Web App) -> events silently do nothing
#   Source: https://ai.syncfusion.com/blazor/llms.txt (retrieved 2026-09-01)
#
# Exit 0 = complete. Exit 1 = something is missing.

set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
SKIP='-path ./node_modules -o -path ./.git -o -path */obj -o -path */bin -o -path ./.agent'
FAILED=0
fail() { echo "FAIL: $*" >&2; FAILED=1; }
note() { echo "      $*" >&2; }

CSPROJ=$(find . \( $SKIP \) -prune -o -name '*.csproj' -print 2>/dev/null)
[ -z "$CSPROJ" ] && { echo "SKIP: no .csproj found."; exit 0; }
if ! echo "$CSPROJ" | tr '\n' '\0' | xargs -0 grep -lq 'Syncfusion.Blazor' 2>/dev/null; then
  echo "SKIP: Syncfusion.Blazor is not referenced."
  exit 0
fi

STARTUP=$(find . \( $SKIP \) -prune -o -type f \( -name 'Program.cs' -o -name 'Startup.cs' \) -print 2>/dev/null)
RAZOR=$(find . \( $SKIP \) -prune -o -type f -name '*.razor' -print 2>/dev/null)
HTML=$(find . \( $SKIP \) -prune -o -type f \( -name 'App.razor' -o -name '_Host.cshtml' -o -name '_Layout.cshtml' -o -name 'index.html' \) -print 2>/dev/null)

# ---------------------------------------------------------------------------
# 1. AddSyncfusionBlazor()
# ---------------------------------------------------------------------------
if [ -z "$STARTUP" ]; then
  fail "no Program.cs or Startup.cs found; cannot verify AddSyncfusionBlazor()."
elif ! echo "$STARTUP" | tr '\n' '\0' | xargs -0 grep -lq 'AddSyncfusionBlazor' 2>/dev/null; then
  fail "AddSyncfusionBlazor() is never called."
  note "Without it every Syncfusion component renders EMPTY - no error, no"
  note "exception, and no failing test. Add to Program.cs:"
  note "  builder.Services.AddSyncfusionBlazor();"
fi

# ---------------------------------------------------------------------------
# 2. Theme stylesheet
# ---------------------------------------------------------------------------
if [ -n "$HTML" ]; then
  if ! echo "$HTML" | tr '\n' '\0' | xargs -0 grep -lqE '_content/Syncfusion\.Blazor|Syncfusion\.Blazor\.Themes|sf-theme|bootstrap5\.css' 2>/dev/null; then
    fail "no Syncfusion theme stylesheet is linked."
    note "Components render unstyled. Add to App.razor (or _Host.cshtml):"
    note '  <link href="_content/Syncfusion.Blazor.Themes/bootstrap5.css" rel="stylesheet" />'
  fi
else
  note "WARN: no App.razor/_Host.cshtml/index.html found; theme link unverified."
fi

# ---------------------------------------------------------------------------
# 3. Render mode for interactive components (.NET 8+ Blazor Web App)
# ---------------------------------------------------------------------------
IS_WEB_APP=0
echo "$CSPROJ" | tr '\n' '\0' | xargs -0 grep -lqE '<TargetFramework>net(8|9|10)\.0' 2>/dev/null \
  && echo "$HTML" | tr '\n' '\0' | xargs -0 grep -lq 'Routes' 2>/dev/null && IS_WEB_APP=1

if [ "$IS_WEB_APP" -eq 1 ] && [ -n "$RAZOR" ]; then
  # Pages using an interactive Syncfusion component but declaring no render mode.
  OFFENDERS=""
  for f in $RAZOR; do
    grep -qE '<Sf[A-Z]' "$f" 2>/dev/null || continue
    grep -qE '@(bind|on[A-Za-z]+)=|EventCallback|@ref' "$f" 2>/dev/null || continue
    grep -qE '@rendermode|@attribute \[RenderMode' "$f" 2>/dev/null && continue
    # A parent may set it globally on Routes/HeadOutlet.
    echo "$HTML" | tr '\n' '\0' | xargs -0 grep -lq '@rendermode' 2>/dev/null && continue
    OFFENDERS="$OFFENDERS$f"$'\n'
  done
  if [ -n "$OFFENDERS" ]; then
    fail "interactive Syncfusion components with no render mode declared:"
    echo "$OFFENDERS" | grep -v '^$' | sed 's/^/        /' >&2
    note "In a .NET 8+ Blazor Web App, static SSR is the default: events bind but"
    note "never fire, so the UI looks correct and does nothing. Add @rendermode"
    note "InteractiveServer (or InteractiveWebAssembly/InteractiveAuto)."
  fi
fi

[ "$FAILED" -ne 0 ] && exit 1
echo "PASS: AddSyncfusionBlazor, theme stylesheet, and render modes are in place."
