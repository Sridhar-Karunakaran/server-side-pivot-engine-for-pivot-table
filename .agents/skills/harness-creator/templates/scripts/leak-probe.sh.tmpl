#!/usr/bin/env bash
# Gate: leak-dotnet / document-memory   (parser: gcdump-delta)
#
# Grow-and-measure. This is the ONLY way to establish whether a leak exists: heap
# retention is a property of a running process over time, and no amount of source
# review can observe it. An LLM asked "is there a memory leak?" can only guess.
#
# Emits {EVIDENCE_DIR}/heap-baseline.json and heap-after.json, each {"heapBytes":N}.
# The gcdump-delta parser thresholds on growthRatio, not absolute size - absolute
# heap size is not a leak signal, unbounded growth is.
#
# Usage: leak-probe.sh <EVIDENCE_DIR>
# Requires: dotnet-gcdump, dotnet-counters  (both MIT, free, from Microsoft)
#   dotnet tool install -g dotnet-gcdump
#   dotnet tool install -g dotnet-counters

set -uo pipefail
EVIDENCE_DIR="${1:?usage: leak-probe.sh <EVIDENCE_DIR>}"
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
mkdir -p "$EVIDENCE_DIR"

# ---- configure per project -------------------------------------------------
SCENARIO_PROJECT="${SCENARIO_PROJECT:-tests/LeakScenarios}"   # runnable scenario host
ITERATIONS="${ITERATIONS:-200}"       # repetitions of the suspect path
WARMUP_ITERATIONS="${WARMUP_ITERATIONS:-20}"  # excluded: JIT, pools, caches settle here
# ---------------------------------------------------------------------------

command -v dotnet-gcdump >/dev/null 2>&1 || {
  echo "FAIL: dotnet-gcdump not installed." >&2
  echo "      dotnet tool install -g dotnet-gcdump" >&2
  exit 127
}

if [ ! -d "$SCENARIO_PROJECT" ]; then
  cat >&2 <<MSG
FAIL: no leak-scenario host at $SCENARIO_PROJECT

      This gate needs a runnable host that exercises the suspect path in a loop.
      Create one that reads two environment variables and exits:

        LEAK_WARMUP     iterations to run before the baseline snapshot
        LEAK_ITERATIONS iterations to run after it

      Between the two phases it must print READY_FOR_BASELINE and wait for a
      newline on stdin, so this script can snapshot at the right moment.

      Set SCENARIO_PROJECT to override the path.
MSG
  exit 1
fi

heap_bytes() {   # $1 = pid, $2 = output .gcdump path
  dotnet-gcdump collect -p "$1" -o "$2" --timeout 120 >/dev/null 2>&1 || return 1
  # Total managed heap size in bytes, summed from the gcdump report.
  dotnet-gcdump report "$2" 2>/dev/null \
    | awk '/^ *[0-9]/ {gsub(/,/,"",$2); s+=$2} END {printf "%.0f", s+0}'
}

echo "Starting scenario host (warmup=$WARMUP_ITERATIONS, iterations=$ITERATIONS)..."

# Named pipes rather than `coproc`: coproc needs bash 4+, and macOS ships 3.2.
PIPE_DIR=$(mktemp -d)
mkfifo "$PIPE_DIR/in" "$PIPE_DIR/out"
HOST_LOG="$EVIDENCE_DIR/leak-host.log"

LEAK_WARMUP="$WARMUP_ITERATIONS" LEAK_ITERATIONS="$ITERATIONS" \
  dotnet run --project "$SCENARIO_PROJECT" --no-build \
  < "$PIPE_DIR/in" > "$PIPE_DIR/out" 2>"$HOST_LOG" &
HOST_PID=$!

# Hold the write end open so the host does not see EOF on stdin immediately.
exec 3>"$PIPE_DIR/in"

cleanup() {
  exec 3>&- 2>/dev/null
  kill "$HOST_PID" 2>/dev/null
  rm -rf "$PIPE_DIR"
}
trap cleanup EXIT

# Wait for warmup to finish, so pools, caches and JIT are not counted as a leak.
READY=0
while IFS= read -r -t 300 line; do
  echo "  host: $line"
  case "$line" in *READY_FOR_BASELINE*) READY=1; break ;; esac
done < "$PIPE_DIR/out"

if [ "$READY" -ne 1 ]; then
  echo "FAIL: scenario host never printed READY_FOR_BASELINE (see $HOST_LOG)" >&2
  exit 1
fi

BASE=$(heap_bytes "$HOST_PID" "$EVIDENCE_DIR/baseline.gcdump") || {
  echo "FAIL: baseline gcdump failed (see $HOST_LOG)" >&2; exit 1; }
printf '{"heapBytes":%s,"phase":"baseline","iterations":%s}\n' \
  "$BASE" "$WARMUP_ITERATIONS" > "$EVIDENCE_DIR/heap-baseline.json"
echo "  baseline: $BASE bytes"

echo "" >&3                      # release the host into the measured phase

# Wait for the host to finish the measured loop and signal again.
READY=0
while IFS= read -r -t 1800 line; do
  echo "  host: $line"
  case "$line" in *READY_FOR_MEASURE*) READY=1; break ;; esac
done < "$PIPE_DIR/out"

if [ "$READY" -ne 1 ]; then
  cat >&2 <<'MSG'
FAIL: scenario host never printed READY_FOR_MEASURE.

      The host must stay alive after its measured loop so the heap can be
      snapshotted. Contract:
        1. run LEAK_WARMUP iterations
        2. print READY_FOR_BASELINE, then block reading a line from stdin
        3. run LEAK_ITERATIONS iterations
        4. force collection: GC.Collect(); GC.WaitForPendingFinalizers(); GC.Collect();
        5. print READY_FOR_MEASURE, then block reading a line from stdin
        6. exit
MSG
  exit 1
fi

AFTER=$(heap_bytes "$HOST_PID" "$EVIDENCE_DIR/after.gcdump") || {
  echo "FAIL: post-run gcdump failed (see $HOST_LOG)" >&2; exit 1; }
printf '{"heapBytes":%s,"phase":"after","iterations":%s}\n' \
  "$AFTER" "$ITERATIONS" > "$EVIDENCE_DIR/heap-after.json"
echo "  after:    $AFTER bytes"

echo "" >&3                      # let the host exit
wait "$HOST_PID" 2>/dev/null || true

awk -v b="$BASE" -v a="$AFTER" 'BEGIN{
  if (b>0) printf "  growth:   %.1f%% (ratio %.3f)\n", (a-b)/b*100, a/b;
}'
echo "Wrote heap-baseline.json and heap-after.json."
echo "The gcdump-delta parser thresholds on growthRatio - unbounded growth is the"
echo "leak signal, not absolute heap size."
