#!/usr/bin/env bash
# Gate: syncfusion-banner-suppression
#
# Syncfusion mandatory rule: "Never suppress, hide, catch or CSS-hide a licensing
# banner or warning."
#   Source: https://ai.syncfusion.com/blazor/llms.txt (retrieved 2026-09-01)
#
# An agent told "remove the trial banner" will reach for display:none or a
# swallowed exception rather than fixing registration - turning a licensing
# problem into a silent compliance breach that ships to customers.
#
# Exit 0 = clean. Exit 1 = a suppression was found.

set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
SKIP='-path ./node_modules -o -path ./.git -o -path */obj -o -path */bin -o -path ./dist -o -path ./.agent'
FAILED=0

fail() { echo "FAIL: $*" >&2; FAILED=1; }
note() { echo "      $*" >&2; }

FILES=$(find . \( $SKIP \) -prune -o -type f \
          \( -name '*.cs' -o -name '*.razor' -o -name '*.css' -o -name '*.scss' \
             -o -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.jsx' \
             -o -name '*.html' -o -name '*.xaml' -o -name '*.vue' \) -print 2>/dev/null)
[ -z "$FILES" ] && { echo "SKIP: no source files."; exit 0; }

# ---------------------------------------------------------------------------
# 1. CSS hiding of the licence banner / dialog.
# ---------------------------------------------------------------------------
CSS_HITS=$(echo "$FILES" | tr '\n' '\0' \
  | xargs -0 grep -HniE '(e-licens|sf-licens|licens[a-z]*-(banner|dialog|message|warning)|e-trial|trial-(banner|message))' 2>/dev/null \
  | grep -iE 'display[[:space:]]*:[[:space:]]*none|visibility[[:space:]]*:[[:space:]]*hidden|opacity[[:space:]]*:[[:space:]]*0|remove\(\)|\.hide\(\)|hidden[[:space:]]*=[[:space:]]*(true|"true")' || true)
if [ -n "$CSS_HITS" ]; then
  fail "licensing banner is hidden by style or DOM removal:"
  echo "$CSS_HITS" | sed 's/^/        /' >&2
fi

# ---------------------------------------------------------------------------
# 2. Swallowing a licensing exception.
# ---------------------------------------------------------------------------
LIC_FILES=$(echo "$FILES" | tr '\n' '\0' \
  | xargs -0 grep -liE 'licens' 2>/dev/null || true)
# awk rather than `grep -z`: BSD grep does not honour [^\n] inside an ERE when
# -z is used, so the multi-line pattern silently never matched.
for f in $LIC_FILES; do
  EMPTY_CATCH=$(awk '
    /catch[[:space:]]*(\(|\{|$)/ { inCatch = 1; body = ""; line = NR }
    inCatch {
      s = $0
      sub(/.*catch[^{]*\{/, "", s)       # text after the opening brace
      gsub(/\/\/.*/, "", s)               # strip line comments
      gsub(/[[:space:]]/, "", s)
      if (s ~ /\}/) {                     # closing brace reached
        sub(/\}.*/, "", s)
        if (s == "" && body == "") print "line " line ": empty catch block"
        inCatch = 0
      } else {
        body = body s
      }
    }' "$f" 2>/dev/null || true)
  if [ -n "$EMPTY_CATCH" ]; then
    fail "$f swallows an exception in a file that handles licensing:"
    echo "$EMPTY_CATCH" | sed "s|^|        |" >&2
    note "A swallowed licensing exception hides an unlicensed state at runtime."
  fi
done

# ---------------------------------------------------------------------------
# 3. Analyzer/compiler suppression of Syncfusion licensing diagnostics.
# ---------------------------------------------------------------------------
SUPP=$(echo "$FILES" | tr '\n' '\0' \
  | xargs -0 grep -HniE '(#pragma warning disable|SuppressMessage|eslint-disable|@ts-ignore)' 2>/dev/null \
  | grep -iE 'licens|syncfusion' || true)
if [ -n "$SUPP" ]; then
  fail "a diagnostic relating to Syncfusion licensing is suppressed:"
  echo "$SUPP" | sed 's/^/        /' >&2
fi

if [ "$FAILED" -ne 0 ]; then
  cat >&2 <<'MSG'

      A visible licensing banner means the license is missing, invalid, or
      registered too late. The fix is always to correct registration - never to
      hide the symptom:
        - register before the first Syncfusion component is created
        - read the key from configuration or the environment, never a literal
        - a key is version-specific; an upgrade may need a regenerated key
      Docs: https://ai.syncfusion.com/licensing.md
MSG
  exit 1
fi
echo "PASS: no licensing-banner suppression found."
