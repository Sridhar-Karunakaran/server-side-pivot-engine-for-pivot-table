{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PivotDataSource": {
    "Type": "Csv",
    "JsonPath": "sales-analysis.json",
    "CsvPath": "sales.csv",
    "CsvDelimiter": ",",
    "DatabasePath": "sales.db",
    "InitializationScript": "sales.sql",
    "Query": "SELECT Region, Country, ItemType, SalesChannel, OrderDate, UnitsSold, TotalRevenue, TotalCost, TotalProfit FROM Sales"
  },
  "DataServer": {
    "DefaultIndexId": "default",
    "General": {
      "Port": 5285,
      "MinimumLogLevel": "Info",
      "DataFolder": "DataSource"
    },
    "DataStorage": {
      "RetryAttempts": 3,
      "CacheSizeLimit": 100,
      "KeepDataOnRefresh": true,
      "MaxCacheItemSizeBytes": 0
    },
    "DatabaseQuery": {
      "CommandTimeoutEnabled": false,
      "CommandTimeLimit": 150
    },
    "Https": {
      "Enabled": false,
      "Protocols": "HTTP1_AND_HTTP2"
    },
    "Security": {
      "BasicAuthEnabled": false,
      "AllowedOrigins": [ "*" ]
    },
    "ReportSharing": {
      "EndpointEnabled": false
    },
    "Indexes": [
      {
        "Index": "Sample-Csv",
        "Name": "Sample CSV (file-driven config)",
        "SourceType": "Csv",
        "SourcePath": "Sample.csv",
        "CsvDelimiter": ",",
        "CsvDecimalSeparator": ".",
        "CsvThousandsSeparator": ",",
        "AutoReload": true,
        "ReloadIntervalMinutes": 15,
        "Enabled": true
      },
      {
        "Index": "Data-Csv",
        "Name": "Data CSV (file-driven config)",
        "SourceType": "Csv",
        "SourcePath": "data.csv",
        "CsvDelimiter": ",",
        "CsvDecimalSeparator": ".",
        "AutoReload": true,
        "ReloadIntervalMinutes": 30,
        "Enabled": true
      }
    ]
  },
  "ConnectionStrings": {
    "SalesDb": "Data Source=DataSource/sales.db"
  }
}