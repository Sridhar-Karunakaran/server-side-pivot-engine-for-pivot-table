{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataServer": {
    "DefaultIndexId": "Sales-Json",
    "KeepDataOnRefresh": true,
    "RetryAttempts": 3,
    "Indexes": [
      {
        "Index": "Sales-Json",
        "Name": "Sales Analysis JSON (file-driven config)",
        "SourceType": "Json",
        "SourcePath": "sales-analysis.json",
        "MappingEnabled": false,
        "AutoReload": true,
        "ReloadIntervalMinutes": 20,
        "Enabled": true
      },
      {
        "Index": "Data-Csv",
        "Name": "Data CSV (file-driven config)",
        "SourceType": "Csv",
        "SourcePath": "data.csv",
        "CsvDelimiter": ",",
        "CsvDecimalSeparator": ",",
        "AutoReload": true,
        "ReloadIntervalMinutes": 30,
        "Enabled": true,
        "CsvThousandsSeparator": "."
      }
    ]
  },
  "General": {
    "Port": 5285,
    "MinimumLogLevel": "Info",
    "DataFolder": "DataSource"
  }
}