{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseQuery": {
    "CommandTimeoutEnabled": true,
    "CommandTimeLimit": 2
  },
  "DataServer": {
    "DefaultIndexId": "Sales-Json",
    "Indexes": [
      {
        "Index": "Sales-Json",
        "Name": "Sales Analysis JSON (file-driven config)",
        "SourceType": "Json",
        "SourcePath": "sales-analysis.json",
        "MappingEnabled": false,
        "AutoReload": true,
        "ReloadIntervalMinutes": 20,
        "Enabled": true
      },
      {
        "Index": "Data-Csv",
        "Name": "Data CSV (file-driven config)",
        "SourceType": "Csv",
        "SourcePath": "data.csv",
        "CsvDelimiter": ",",
        "CsvDecimalSeparator": ",",
        "AutoReload": true,
        "ReloadIntervalMinutes": 30,
        "Enabled": false,
        "CsvThousandsSeparator": "."
      }
    ]
  },
  "General": {
    "Port": 8765,
    "MinimumLogLevel": "Info",
    "DataFolder": "DataSource"
  },
  "DataStorage": {
    "RetryAttempts": 3,
    "CacheSizeLimit": 100,
    "KeepDataOnRefresh": true,
    "MaxCacheItemSizeBytes": 0
  },
  "ReportSharingOptions": {
    "EndpointEnabled": false,
    "PathToFolder": "DataServer/reports",
    "ReportExpirationTime": 0,
    "MaxSizeOfFolder": 0,
    "AutoDeletingEnabled": false
  },
  "Security": {
    "Authorization": {
      "Enabled": false,
      "Username": "",
      "Password": ""
    },
    "CORS": {
      "AllowOrigin": "*"
    }
  },
  "Https": {
    "Enabled": false,
    "PemCertPath": null,
    "PemKeyPath": null,
    "PfxPath": null,
    "PfxPassword": null,
    "StoreLocation": null,
    "StoreName": null,
    "Thumbprint": null,
    "SubjectName": null,
    "Protocols": "HTTP1_AND_HTTP2"
  }
}